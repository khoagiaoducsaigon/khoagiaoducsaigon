# ============================================================
# MultiPost - Bien moi truong
# Copy file nay thanh .env roi dien thong tin that
# ============================================================

PORT=8787
# URL cong khai cua server (BAT BUOC neu upload anh/video tu may len
# de dang Instagram / Threads / TikTok - cac nen tang nay tai media tu URL)
PUBLIC_BASE_URL=http://localhost:8787

# Che do mo phong: 1 = khong goi API that, chi gia lap ket qua
DRY_RUN=0

# Mat khau bao ve giao dien (de trong = khong bao ve)
ADMIN_TOKEN=

# --- Facebook Page ---------------------------------------
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# --- Instagram Business / Creator ------------------------
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# --- Threads ---------------------------------------------
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# --- TikTok Content Posting API --------------------------
TIKTOK_ACCESS_TOKEN=
# SELF_ONLY | PUBLIC_TO_EVERYONE | MUTUAL_FOLLOW_FRIENDS | FOLLOWER_OF_CREATOR
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# --- Telegram Bot ----------------------------------------
TELEGRAM_BOT_TOKEN=
# Nhieu dich: ngan cach bang dau phay. VD: @kenh_cua_toi,-1001234567890
TELEGRAM_CHAT_IDS=

# --- WhatsApp Cloud API ----------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Danh sach so nhan, dinh dang E.164 khong dau +, ngan cach bang dau phay
WHATSAPP_RECIPIENTS=

# --- Zalo Official Account ---------------------------------
ZALO_OA_ACCESS_TOKEN=
# message = nhan tin toi nguoi theo doi | article = dang bai tren trang OA | both = ca hai
ZALO_POST_MODE=message
# User ID nguoi theo doi OA, ngan cach bang dau phay
ZALO_USER_IDS=
# Ba khoa duoi day de he thong tu lam moi access token (token Zalo chi song 1 gio)
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_REFRESH_TOKEN=
# Ten tac gia hien thi tren bai viet OA (chi dung o che do article)
ZALO_ARTICLE_AUTHOR=

GRAPH_API_VERSION=v21.0
